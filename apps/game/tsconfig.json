{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.tsbuild/game",
    "tsBuildInfoFile": "../../node_modules/.tsbuild/game.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "paths": { "react": ["../../node_modules/preact/compat"], "react-dom": ["../../node_modules/preact/compat"] }
  },
  "include": ["src", "src/**/*.json"],
  "references": [{ "path": "../../packages/core" }]
}
